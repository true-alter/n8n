{
  "name": "@truealter/n8n-nodes-alter",
  "version": "0.1.1",
  "description": "n8n nodes for ~alter, identity infrastructure. Resolve a ~handle, verify one is known, register your own, and confirm the wire is live, from any n8n workflow.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "alter",
    "identity",
    "mcp",
    "truealter",
    "registration"
  ],
  "license": "Apache-2.0",
  "homepage": "https://truealter.com",
  "author": {
    "name": "Alter Meridian Pty Ltd",
    "email": "hey@truealter.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/true-alter/n8n.git"
  },
  "bugs": {
    "url": "https://github.com/true-alter/n8n/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes --write",
    "lint": "eslint nodes package.json",
    "lintfix": "eslint nodes package.json --fix",
    "prepublishOnly": "npm run build && npm run lint -s",
    "test": "jest"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/Alter/Alter.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "gulp": "^5.0.0",
    "jest": "^29.7.0",
    "n8n-workflow": "*",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
